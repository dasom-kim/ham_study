<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dday_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- 헤더 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐹 D-Day"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp" />

    <!-- 빈 상태 -->
    <TextView
        android:id="@+id/dday_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="즐겨찾기 디데이 없음"
        android:textSize="12sp"
        android:textColor="#888888"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- 디데이 목록 -->
    <LinearLayout
        android:id="@+id/dday_list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/dday_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">
            <TextView android:id="@+id/dday_title1"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#333333"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/dday_value1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#FF5722" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dday_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">
            <TextView android:id="@+id/dday_title2"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#333333"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/dday_value2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#FF5722" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dday_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">
            <TextView android:id="@+id/dday_title3"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#333333"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/dday_value3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#FF5722" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dday_row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/dday_title4"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#333333"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/dday_value4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#FF5722" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
